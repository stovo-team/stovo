    {
      "id": "GITOPS-01",
      "expected": "Only tested, atomically promoted, current source and image digests are eligible for production."
    },
    {
      "id": "GITOPS-02",
      "expected": "Doco-CD polls the designated release branch and deploys pinned images without SSH deployment."
    },
    {
      "id": "GITOPS-03",
      "expected": "Shared services and registered dynamic tenants converge while tenant lifecycle remains functional."
    },
    {
      "id": "GITOPS-04",
      "expected": "Master and tenant migrations execute safely and report failures."
    },
    {
      "id": "GITOPS-05",
      "expected": "Version-pinned OCI Vault secrets reach intended workloads without leaking."
    },
    {
      "id": "GITOPS-06",
      "expected": "Failures surface and retries preserve existing workloads and data."
    },
    {
      "id": "GITOPS-07",
      "expected": "Doco-CD and all selected workloads run on actual ARM64."
    },
    {
      "id": "GITOPS-08",
      "expected": "Existing production resources and data survive adoption and tested recovery."
    },
    {
      "id": "GITOPS-09",
      "expected": "One deployment writer is active and old SSH jobs are retired only after authorized validation."
    }
  ],
