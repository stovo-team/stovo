# ── Domain ───────────────────────────────────────────────────────────────────
# The public hostname Caddy serves (no scheme, no trailing slash).
APP_DOMAIN=stovo-local.stovo.ru

# Full URLs used internally by the backend for self-references.
APP_ENV=production
APP_URL=https://stovo-local.stovo.ru
CORS_ALLOWED_ORIGINS=capacitor://localhost
NATIVE_CLIENT_ORIGINS=capacitor://localhost
API_URL=https://stovo-local.stovo.ru
FRONTEND_ORIGIN=https://stovo-local.stovo.ru
PUBLIC_TUNNEL_ORIGIN=https://stovo-local.stovo.ru

# ── Public IP ────────────────────────────────────────────────────────────────
# The VPS public IPv4 address. Used by coturn (--external-ip) so TURN relay
# candidates advertise the right address to WebRTC peers.
# Find it with: curl -s https://api.ipify.org
PUBLIC_IP=

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=family_user
POSTGRES_PASSWORD=change_this_strong_postgres_password
POSTGRES_DB=family_messenger
# For a managed PostgreSQL database, set this to its provider-issued URL
# (including sslmode=require or verify-full as required). It overrides the
# POSTGRES_* host/user/password/database values in the backend.
# DATABASE_URL=postgres://user:password@db.example.ru:5432/stovo?sslmode=require

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change_this_strong_redis_password
# Worker streams use the separate redis-jobs Compose service. Leave this unset
# only for a deliberately small/local single-Redis installation.
REDIS_JOBS_URL=redis://:change_this_strong_redis_password@redis-jobs:6379/0

# ── Auth secrets ─────────────────────────────────────────────────────────────
JWT_SECRET=change_this_strong_jwt_secret
REFRESH_TOKEN_SECRET=change_this_strong_refresh_secret
INVITE_TOKEN_SECRET=change_this_strong_invite_secret

# ── Encryption ───────────────────────────────────────────────────────────────
# 32-byte key base64-encoded. Generate: openssl rand -base64 32
MESSAGE_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# ── Storage ──────────────────────────────────────────────────────────────────
STORAGE_PROVIDER=minio
# Cloud.ru Object Storage is S3-compatible. To use it instead of MinIO, set:
# STORAGE_PROVIDER=s3
# S3_ENDPOINT=s3.cloud.ru
# S3_SECURE=true
# MINIO_ACCESS_KEY=<tenant_id>:<key_id>
# MINIO_SECRET_KEY=<key_secret>
# MINIO_FILES_BUCKET=<your-existing-bucket>
# MINIO_LOGS_BUCKET=<your-existing-log-bucket-or-the-same-bucket>
# MINIO_CALLS_BUCKET=<your-existing-calls-bucket-or-the-same-bucket>
MAX_UPLOAD_SIZE_MB=100
MINIO_ROOT_USER=stovo_minio_root
MINIO_ROOT_PASSWORD=change_this_strong_minio_root_password
MINIO_ACCESS_KEY=stovo_backend
MINIO_SECRET_KEY=change_this_strong_minio_backend_password
# Leave empty for single domain mode (runs all uploads/downloads through APP_DOMAIN).
MINIO_PUBLIC_ENDPOINT=
MINIO_PUBLIC_SECURE=true
MINIO_FILES_BUCKET=stovo-files
MINIO_LOGS_BUCKET=stovo-logs
MINIO_CALLS_BUCKET=stovo-calls
MEDIA_MAX_UPLOAD_SIZE=100MB

# ── TURN server ──────────────────────────────────────────────────────────────
# TURN_HOST: the hostname or IP clients use to reach coturn.
# Usually the same as APP_DOMAIN (or PUBLIC_IP if DNS is not set up).
TURN_ENABLED=true
TURN_HOST=stovo-local.stovo.ru
TURN_PORT=3478
TURN_REALM=stovo-local.stovo.ru
TURN_USERNAME=family
TURN_PASSWORD=change_this_strong_turn_password
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200

# ── LiveKit SFU (group calls >4 participants) ────────────────────────────────
# Clients connect to LIVEKIT_URL (ws/wss). API key/secret mint participant JWTs.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_KEYS="devkey: secret"

# ── Misc ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_BUFFER_MAX_RECORDS=2000
VITE_DISABLE_HMR=true

# ── Blue/green backend ───────────────────────────────────────────────────────
# Caddy proxies /api and /socket.io to this compose service name.
# Local compose starts only backend-blue. Deploy starts backend-green via the
# bluegreen profile when cutting over, without stopping postgres/redis/minio.
ACTIVE_BACKEND=backend-blue

# ── AI Audio Transcription (Groq Whisper) ───────────────────────────────────
# API key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
# Optional custom API base URL or reverse proxy (e.g. if api.groq.com is geo-blocked in your region)
# GROQ_BASE_URL=https://api.groq.com
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_CHAT_MODEL=
GROQ_STT_COST_PER_AUDIO_HOUR_USD=0.04
AI_CALL_TRANSCRIPTION_ENABLED=true
MINIO_CALLS_BUCKET=stovo-calls

# ── MinIO resource caps (optional) ───────────────────────────────────────────
# Keep local MinIO from claiming most of host RAM / scanning forever on boot.
# MINIO_MEMLIMIT=256MiB
# MINIO_CONTAINER_MEM_LIMIT=384m

