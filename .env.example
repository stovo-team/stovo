# ── Domain ───────────────────────────────────────────────────────────────────
# The public hostname Caddy serves (no scheme, no trailing slash).
APP_DOMAIN=stovo-local.stovo.ru

# Full URLs used internally by the backend for self-references.
APP_ENV=production
APP_URL=https://stovo-local.stovo.ru
API_URL=https://stovo-local.stovo.ru
FRONTEND_ORIGIN=https://stovo-local.stovo.ru
PUBLIC_TUNNEL_ORIGIN=https://stovo-local.stovo.ru

# ── Public IP ────────────────────────────────────────────────────────────────
# The VPS public IPv4 address. Used by coturn (--external-ip) so TURN relay
# candidates advertise the right address to WebRTC peers.
# Find it with: curl -s https://api.ipify.org
PUBLIC_IP=

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=family_user
POSTGRES_PASSWORD=change_this_strong_postgres_password
POSTGRES_DB=family_messenger

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change_this_strong_redis_password

# ── Auth secrets ─────────────────────────────────────────────────────────────
JWT_SECRET=change_this_strong_jwt_secret
REFRESH_TOKEN_SECRET=change_this_strong_refresh_secret
INVITE_TOKEN_SECRET=change_this_strong_invite_secret

# ── Encryption ───────────────────────────────────────────────────────────────
# 32-byte key base64-encoded. Generate: openssl rand -base64 32
MESSAGE_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# ── Storage ──────────────────────────────────────────────────────────────────
STORAGE_PROVIDER=minio
MAX_UPLOAD_SIZE_MB=100
MINIO_ROOT_USER=stovo_minio_root
MINIO_ROOT_PASSWORD=change_this_strong_minio_root_password
MINIO_ACCESS_KEY=stovo_backend
MINIO_SECRET_KEY=change_this_strong_minio_backend_password

# ── TURN server ──────────────────────────────────────────────────────────────
# TURN_HOST: the hostname or IP clients use to reach coturn.
# Usually the same as APP_DOMAIN (or PUBLIC_IP if DNS is not set up).
TURN_ENABLED=true
TURN_HOST=stovo-local.stovo.ru
TURN_PORT=3478
TURN_REALM=stovo-local.stovo.ru
TURN_USERNAME=family
TURN_PASSWORD=change_this_strong_turn_password
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200

# ── LiveKit SFU (group calls >4 participants) ────────────────────────────────
# Clients connect to LIVEKIT_URL (ws/wss). API key/secret mint participant JWTs.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_KEYS="devkey: secret"

# ── Misc ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_BUFFER_MAX_RECORDS=2000
VITE_DISABLE_HMR=true
