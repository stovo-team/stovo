+func (s *Server) handleQuickStartPublicAccess(w http.ResponseWriter, r *http.Request, user userPublic) {
+	if err := s.requireAdmin(user); err != nil {
+		s.detail(w, http.StatusForbidden, "Admin access required")
+		return
+	}
+
+	provider := "cloudflare"
+	snapshot := s.tunnel.Status()
+	publicURL := ""
+	if snapshot.URL != nil && strings.TrimSpace(*snapshot.URL) != "" {
+		publicURL = strings.TrimRight(strings.TrimSpace(*snapshot.URL), "/")
+		if snapshot.Provider != nil && strings.TrimSpace(*snapshot.Provider) != "" {
+			provider = *snapshot.Provider
+		}
+	} else {
+		snapshot = s.tunnel.Start(s.cfg.PublicTunnelOrigin, provider, true)
+		if snapshot.URL == nil {
+			s.detail(w, http.StatusBadGateway, snapshotMessage(snapshot, "Could not create public tunnel"))
+			return
+		}
+		publicURL = strings.TrimRight(strings.TrimSpace(*snapshot.URL), "/")
+	}
+
+	if err := s.validatePublicTunnelURL(publicURL); err != nil {
+		s.detail(w, http.StatusBadGateway, "Public tunnel is not usable: "+err.Error())
+		return
+	}
+	if err := s.savePublicAccessURL(r.Context(), user.FamilyID, publicURL); err != nil {
+		s.detail(w, http.StatusInternalServerError, "Could not save public access")
+		return
+	}
+
+	family, err := s.getFamily(user.FamilyID)
+	if err != nil {
+		s.detail(w, http.StatusNotFound, "Family not found")
+		return
+	}
+	inviteLinks, err := s.createQuickStartInviteLinks(r.Context(), user, family)
+	if err != nil {
+		s.detail(w, http.StatusInternalServerError, "Could not create invite links")
+		return
+	}
+	settings := publicAccessSettingsForFamily(family, s.cfg.AppURL, s.cfg.APIURL)
+	s.json(w, http.StatusOK, quickStartPublicAccessResponse{
+		Status:       snapshot.State,
+		Provider:     provider,
+		PublicURL:    publicURL,
+		Origin:       snapshot.Origin,
+		Message:      snapshot.Message,
+		PublicAccess: settings,
+		InviteLinks:  inviteLinks,
+	})
+}
+
+func (s *Server) savePublicAccessURL(ctx context.Context, familyID, publicURL string) error {
+	publicURL = strings.TrimRight(strings.TrimSpace(publicURL), "/")
+	return s.withTx(ctx, func(tx *sql.Tx) error {
+		_, err := s.txExec(tx, `
+			UPDATE families
+			SET public_app_url = ?, public_api_url = ?, updated_at = ?
+			WHERE id = ?
+		`, publicURL, publicURL, nowString(), familyID)
+		return err
+	})
+}
+
+func (s *Server) validatePublicTunnelURL(publicURL string) error {
+	publicURL = strings.TrimRight(strings.TrimSpace(publicURL), "/")
+	if publicURL == "" {
+		return errors.New("empty public URL")
+	}
+	healthURL := publicURL + "/api/health"
+	deadline := time.Now().Add(12 * time.Second)
+	var lastErr error
+	for time.Now().Before(deadline) {
+		req, err := http.NewRequest(http.MethodGet, healthURL, nil)
+		if err != nil {
+			return err
+		}
+		req.Header.Set("Accept", "application/json")
+		req.Header.Set("bypass-tunnel-reminder", "true")
+		req.Header.Set("abypass-tunnel-reminder", "true")
+		client := &http.Client{Timeout: 4 * time.Second}
+		resp, err := client.Do(req)
+		if err != nil {
+			lastErr = err
+			time.Sleep(500 * time.Millisecond)
+			continue
+		}
+		var payload struct {
+			Status string `json:"status"`
+		}
+		decodeErr := json.NewDecoder(resp.Body).Decode(&payload)
+		_ = resp.Body.Close()
+		if resp.StatusCode >= 200 && resp.StatusCode < 300 && decodeErr == nil && payload.Status == "ok" {
+			return nil
+		}
+		if decodeErr != nil {
+			lastErr = fmt.Errorf("%s did not return backend health JSON", healthURL)
+		} else {
+			lastErr = fmt.Errorf("%s returned status %d", healthURL, resp.StatusCode)
+		}
+		time.Sleep(500 * time.Millisecond)
+	}
+	if lastErr != nil {
+		return lastErr
+	}
+	return errors.New("public health check timed out")
+}
+
+func snapshotMessage(snapshot tunnel.Snapshot, fallback string) string {
+	if snapshot.Message != nil && strings.TrimSpace(*snapshot.Message) != "" {
+		return *snapshot.Message
+	}
+	return fallback
+}
+
+func (s *Server) createQuickStartInviteLinks(ctx context.Context, user userPublic, family familyPublic) ([]publicInviteLink, error) {
+	invite, rawToken, err := s.createInviteRecord(ctx, user, memberRole, 168, 20)
+	if err != nil {
+		return nil, err
+	}
+	return []publicInviteLink{
+		{
+			ID:        invite.ID,
+			Role:      invite.Role,
+			URL:       buildInviteURL(family, s.cfg.AppURL, s.cfg.APIURL, rawToken),
+			ExpiresAt: invite.ExpiresAt,
+			MaxUses:   invite.MaxUses,
+			UsedCount: invite.UsedCount,
+		},
+	}, nil
+}
+
+func (s *Server) createInviteRecord(ctx context.Context, user userPublic, role string, expiresHours int, maxUses int) (invitePublic, string, error) {
+	if role == "" {
+		role = memberRole
+	}
+	if !isValidRole(role) || role == ownerRole {
+		return invitePublic{}, "", errors.New("invalid role")
+	}
+	if expiresHours < 1 || expiresHours > 720 || maxUses < 1 || maxUses > 100 {
+		return invitePublic{}, "", errors.New("invalid invite settings")
+	}
+	rawToken, err := randomToken()
+	if err != nil {
+		return invitePublic{}, "", err
+	}
+	inviteID := uuid.NewString()
+	expiresAt := time.Now().Add(time.Duration(expiresHours) * time.Hour).UTC()
+	if err := s.withTx(ctx, func(tx *sql.Tx) error {
+		_, err := s.txExec(tx, `
+			INSERT INTO invites (id, family_id, token_hash, role, expires_at, max_uses, used_count, created_by, created_at)
+			VALUES (?, ?, ?, ?, ?, ?, 0, ?, ?)
+		`, inviteID, user.FamilyID, tokenHash(s.cfg.InviteTokenSecret, rawToken), role, expiresAt.Format(time.RFC3339Nano), maxUses, user.ID, nowString())
+		return err
+	}); err != nil {
+		return invitePublic{}, "", err
+	}
+	invite, err := s.getInviteByID(inviteID)
+	if err != nil {
+		return invitePublic{}, "", err
+	}
+	return invite, rawToken, nil
+}
+
 func (s *Server) handleDomainLink(w http.ResponseWriter, r *http.Request, user userPublic) {
 	if err := s.requireAdmin(user); err != nil {
 		s.detail(w, http.StatusForbidden, "Admin access required")
