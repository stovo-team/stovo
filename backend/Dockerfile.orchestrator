# syntax=docker/dockerfile:1.7

FROM --platform=$BUILDPLATFORM golang:1.25.5-alpine3.21 AS builder

ARG TARGETOS
ARG TARGETARCH

WORKDIR /app

RUN apk add --no-cache git

COPY go.mod go.sum ./
COPY third_party/socketio/go.mod third_party/socketio/go.sum ./third_party/socketio/
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

COPY ./ ./

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64} go build -ldflags="-w -s" -o /orchestrator ./cmd/orchestrator

FROM alpine:latest

LABEL org.opencontainers.image.source="https://github.com/stovo-team/stovo"
RUN apk add --no-cache ca-certificates

WORKDIR /app
COPY --from=builder /orchestrator /app/orchestrator

EXPOSE 8001
CMD ["/app/orchestrator"]
