# syntax=docker/dockerfile:1.7

FROM golang:1.25.5-alpine3.21 AS builder

WORKDIR /app

RUN apk add --no-cache git gcc musl-dev

COPY go.mod go.sum ./
COPY third_party/socketio/go.mod third_party/socketio/go.sum ./third_party/socketio/
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

COPY ./ ./

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /orchestrator ./cmd/orchestrator

FROM alpine:latest
RUN apk add --no-cache ca-certificates

WORKDIR /app
COPY --from=builder /orchestrator /app/orchestrator

EXPOSE 8001
CMD ["/app/orchestrator"]
