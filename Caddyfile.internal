# HTTP gateway used by the isolated dev and stage stacks. LXD publishes the
# gateway through its proxy devices; production continues to use Caddyfile.
(stovo) {
	encode zstd gzip

	handle /api/v1/master* {
		reverse_proxy orchestrator:8001
	}

	@clusterApi path_regexp clusterApi ^/s/([a-zA-Z0-9_-]+)/api/(.*)$
	handle @clusterApi {
		rewrite * /api/{re.clusterApi.2}
		reverse_proxy stovo-backend-{re.clusterApi.1}:8000 {
			header_up X-Forwarded-Prefix /s/{re.clusterApi.1}
		}
	}

	@clusterSocket path_regexp clusterSocket ^/s/([a-zA-Z0-9_-]+)/socket.io/(.*)$
	handle @clusterSocket {
		rewrite * /socket.io/{re.clusterSocket.2}
		reverse_proxy stovo-backend-{re.clusterSocket.1}:8000
	}

	# MCP connection URLs are cluster-scoped just like the API and Socket.IO.
	# Keep the suffix intact so both /mcp and /mcp/... reach the backend handler.
	@clusterMCP path_regexp clusterMCP ^/s/([a-zA-Z0-9_-]+)/mcp(.*)$
	handle @clusterMCP {
		rewrite * /mcp{re.clusterMCP.2}
		reverse_proxy stovo-backend-{re.clusterMCP.1}:8000
	}

	handle /api/* {
		reverse_proxy {$ACTIVE_BACKEND:backend}:8000
	}

	handle /mcp* {
		reverse_proxy {$ACTIVE_BACKEND:backend}:8000
	}

	handle /socket.io* {
		reverse_proxy {$ACTIVE_BACKEND:backend}:8000
	}

	handle_path /ntfy/* {
		@ntfy_write method POST PUT PATCH DELETE
		respond @ntfy_write "Method not allowed" 405
		reverse_proxy ntfy:80
	}

	handle {
		reverse_proxy frontend:8080
	}
}

:8000 {
	import stovo
}
