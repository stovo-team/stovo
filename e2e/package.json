{
  "name": "stovo-e2e",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:mock": "E2E_MODE=mock E2E_BASE_URL=http://127.0.0.1:5180 playwright test tests/storage-plans-ui-regressions.spec.ts",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:ci": "playwright test --reporter=github,html,junit",
    "test:production": "playwright test tests/production-smoke.spec.ts --reporter=github,html,junit",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
