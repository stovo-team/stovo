{
  "name": "stovo-e2e",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:ci": "playwright test --reporter=github,html,junit",
    "test:production": "playwright test tests/production-smoke.spec.ts --reporter=github,html,junit",
    "report": "playwright show-report",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "evidence:capture": "node tools/capture-evidence.mjs",
    "evidence:compare": "node tools/compare-revisions.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
