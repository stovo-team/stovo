{
  "name": "family-messenger-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock --host 127.0.0.1 --port 5174 --strictPort",
    "mock": "vite --mode mock --host 127.0.0.1 --port 5180 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:i18n": "node ../scripts/check-ui-localization.cjs --check",
    "lint": "node ../scripts/check-solid.cjs frontend",
    "lint:all": "node ../scripts/check-solid.cjs all",
    "baseline:update": "node ../scripts/check-solid.cjs --update",
    "check:css-size": "node ../scripts/check-frontend-css-size.cjs"
  },
  "dependencies": {
    "@capacitor-mlkit/barcode-scanning": "^8.2.1",
    "@capacitor/android": "^8.4.3",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.4.0",
    "@excalidraw/excalidraw": "^0.18.1",
    "@simplewebauthn/browser": "14.0.0",
    "@vitejs/plugin-react": "^6.0.5",
    "docx-preview": "^0.4.1",
    "dompurify": "^3.4.17",
    "emoji-picker-react": "^4.19.1",
    "livekit-client": "^2.21.0",
    "lucide-react": "^1.16.0",
    "mammoth": "^1.12.0",
    "marked": "^16.4.2",
    "pdfjs-dist": "^4.10.38",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.2",
    "socket.io-client": "^4.8.1",
    "typescript": "^5.7.2",
    "vite": "^8.3.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitest/coverage-v8": "^4.1.12",
    "jsdom": "^29.1.1",
    "jszip": "^3.10.1",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "sass": "^1.105.1",
    "undici": "^7.29.1",
    "katex": "0.18.2",
    "lodash-es": "4.17.23",
    "nanoid@^3": "3.3.18",
    "nanoid@^4": "5.1.16"
  }
}
