(stovo) {
	encode gzip

	handle /api/v1/master* {
		reverse_proxy orchestrator:8001
	}

	@clusterApi path_regexp clusterApi ^/s/([a-zA-Z0-9_-]+)/api/(.*)$
	handle @clusterApi {
		rewrite * /api/{re.clusterApi.2}
		reverse_proxy stovo-backend-{re.clusterApi.1}:8000
	}

	@clusterSocket path_regexp clusterSocket ^/s/([a-zA-Z0-9_-]+)/socket.io/(.*)$
	handle @clusterSocket {
		rewrite * /socket.io/{re.clusterSocket.2}
		reverse_proxy stovo-backend-{re.clusterSocket.1}:8000
	}

	handle /api/* {
		reverse_proxy {$ACTIVE_BACKEND:backend-blue}:8000
	}

	handle /mcp* {
		reverse_proxy {$ACTIVE_BACKEND:backend-blue}:8000
	}

	handle /socket.io* {
		reverse_proxy {$ACTIVE_BACKEND:backend-blue}:8000
	}

	handle_path /ntfy/* {
		@ntfy_write method POST PUT PATCH DELETE
		respond @ntfy_write "Method not allowed" 405
		reverse_proxy ntfy:80
	}

	handle {
		reverse_proxy frontend:8080
	}
}


{$APP_DOMAIN} {
	header {
		Content-Security-Policy "upgrade-insecure-requests; block-all-mixed-content"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	import stovo
}

# Private S3 API used only by short-lived, server-issued presigned URLs. MinIO
# itself is never host-published; preserve the public Host for SigV4 signing.
media.{$APP_DOMAIN} {
	header {
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		Content-Security-Policy "sandbox; default-src 'none'"
	}

	@mediaMethods method GET HEAD PUT POST DELETE OPTIONS
	handle @mediaMethods {
		request_body {
			max_size {$MEDIA_MAX_UPLOAD_SIZE:100MB}
		}
		reverse_proxy minio:9000 {
			header_up Host {host}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto {scheme}
		}
	}
	respond "Method not allowed" 405
}

http://localhost {
	import stovo
}
