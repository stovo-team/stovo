(stovo) {
	encode gzip

	# Keep an HTTPS document from accepting an accidental HTTP subresource
	# (for example, a URL retained by an older client configuration).
	header {
		Content-Security-Policy "upgrade-insecure-requests"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle /socket.io* {
		reverse_proxy backend:8000
	}

	handle_path /ntfy/* {
		@ntfy_write method POST PUT PATCH DELETE
		respond @ntfy_write "Method not allowed" 405
		reverse_proxy ntfy:80
	}

	handle {
		reverse_proxy frontend:8080 {
			@spa_miss status 404
			handle_response @spa_miss {
				rewrite * /
				reverse_proxy frontend:5173
			}
		}
	}
}

http://localhost {
	import stovo
}

{$APP_DOMAIN} {
	import stovo
}
