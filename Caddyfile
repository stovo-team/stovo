(stovo) {
	encode zstd gzip

	handle /api/v1/master* {
		reverse_proxy orchestrator:8001
	}

	@clusterApi path_regexp clusterApi ^/s/([a-zA-Z0-9_-]+)/api/(.*)$
	handle @clusterApi {
		rewrite * /api/{re.clusterApi.2}
		reverse_proxy stovo-backend-{re.clusterApi.1}:8000
	}

	@clusterSocket path_regexp clusterSocket ^/s/([a-zA-Z0-9_-]+)/socket.io/(.*)$
	handle @clusterSocket {
		rewrite * /socket.io/{re.clusterSocket.2}
		reverse_proxy stovo-backend-{re.clusterSocket.1}:8000
	}

	# MCP connection URLs are cluster-scoped just like the API and Socket.IO.
	# Keep the suffix intact so both /mcp and /mcp/... reach the backend handler.
	@clusterMCP path_regexp clusterMCP ^/s/([a-zA-Z0-9_-]+)/mcp(.*)$
	handle @clusterMCP {
		rewrite * /mcp{re.clusterMCP.2}
		reverse_proxy stovo-backend-{re.clusterMCP.1}:8000
	}

	handle /api/* {
		reverse_proxy {$BACKEND_UPSTREAMS:backend-blue:8000} {
			lb_policy cookie lb_stovo
			lb_retries 2
			lb_try_duration 3s
		}
	}

	handle /mcp* {
		reverse_proxy {$BACKEND_UPSTREAMS:backend-blue:8000} {
			lb_policy cookie lb_stovo
			lb_retries 2
			lb_try_duration 3s
		}
	}

	handle /socket.io* {
		reverse_proxy {$BACKEND_UPSTREAMS:backend-blue:8000} {
			lb_policy cookie lb_stovo
			lb_retries 2
			lb_try_duration 3s
		}
	}

	# LiveKit's signaling endpoint. Keeping it on the app origin lets external
	# guests use WSS without resolving Docker's internal `livekit` hostname.
	# Some deployments advertise the internal service through a `/livekit`
	# prefix. Strip only that proxy prefix: LiveKit itself expects `/rtc/v1`.
	handle_path /livekit/* {
		reverse_proxy livekit:7880
	}

	handle /rtc* {
		reverse_proxy livekit:7880
	}

	handle_path /ntfy/* {
		@ntfy_write method POST PUT PATCH DELETE
		respond @ntfy_write "Method not allowed" 405
		reverse_proxy ntfy:80
	}

	handle {
		reverse_proxy frontend:8080
	}
}


{$APP_DOMAIN} {
	header {
		Content-Security-Policy "upgrade-insecure-requests; block-all-mixed-content"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	import stovo
}


http://localhost {
	import stovo
}
