{$APP_DOMAIN} {
    encode gzip

    handle /api/* {
        reverse_proxy backend:8000
    }

    handle /socket.io* {
        reverse_proxy backend:8000
    }

    handle_path /ntfy/* {
        reverse_proxy ntfy:80
    }

    handle {
        reverse_proxy frontend:5173 {
            @spa_miss status 404
            handle_response @spa_miss {
                rewrite * /
                reverse_proxy frontend:5173
            }
        }
    }
}
