#!/bin/sh
# File-only checkout does not begin a new branch/task context.
[ "$3" = 1 ] || exit 0
[ -f scripts/agent-workflows/prepare-knowledge.mjs ] || exit 0
node scripts/agent-workflows/prepare-knowledge.mjs start >/dev/null ||
  echo 'Knowledge refresh failed; run prepare-knowledge.mjs start before editing.' >&2
exit 0
