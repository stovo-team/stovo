{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stovo task contract v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "taskId",
    "state",
    "artifacts",
    "acceptance",
    "checks",
    "approvals",
    "authorizations"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "taskId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "state": {
      "enum": [
        "draft",
        "awaiting-approval",
        "approved",
        "implementing",
        "verified",
        "ready-for-review",
        "accepted"
      ]
    },
    "artifacts": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "role",
          "path",
          "sha256"
        ],
        "properties": {
          "role": {
            "enum": [
              "spec",
              "test-plan",
              "implementation-plan"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "acceptanceIds",
          "layer",
          "command",
          "required"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "acceptanceIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "layer": {
            "enum": [
              "unit",
              "component",
              "integration",
              "e2e",
              "visual",
              "docs",
              "eval",
              "manual"
            ]
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "actor",
          "source",
          "decision",
          "artifacts"
        ],
        "properties": {
          "actor": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "enum": [
              "approved",
              "accepted"
            ]
          },
          "artifacts": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      }
    },
    "authorizations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "scope",
          "source"
        ],
        "properties": {
          "scope": {
            "enum": [
              "local-implementation",
              "local-tests",
              "independent-qa",
              "publication",
              "issues",
              "projects",
              "administration",
              "merge",
              "deployment"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
