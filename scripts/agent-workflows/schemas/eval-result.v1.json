{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workflow eval result v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "caseDigest",
    "graderDigest",
    "runtime",
    "model",
    "receipt",
    "checks"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string"
    },
    "caseDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "graderDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "runtime": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "receipt": {
      "type": "object",
      "required": [
        "agentId",
        "source"
      ]
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "mandatory",
          "passed",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "mandatory": {
            "type": "boolean"
          },
          "passed": {
            "type": "boolean"
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    }
  }
}
